# Ambiente (usado se houver compose/scripts compartilhados; não exposto ao browser sem prefixo VITE_)
ENVIRONMENT=development
SECRET_KEY=troque-por-uma-chave-secreta-forte
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (referência local / Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kurae_db
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432

# Front-end (variáveis VITE_* são públicas no bundle — NUNCA coloque credenciais secretas aqui)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Kurae Solutions
VITE_SITE_URL=http://localhost:5173

# Antispam (Cloudflare Turnstile — apenas a Site Key pública; deixe vazio em dev local)
VITE_TURNSTILE_SITE_KEY=

# Testes E2E (Playwright)
E2E_BASE_URL=http://localhost:5173
