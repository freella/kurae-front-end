# Copie este arquivo para `.env` (dev) ou `.env.production` (build de produção)
# e ajuste os valores. Apenas variáveis com prefixo VITE_ são expostas ao front-end.

# --- Ambiente / Backend (Django) ---
ENVIRONMENT=dev
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=backend_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# --- Front-end (Vite) ---
# URL base da API
VITE_API_BASE_URL=http://localhost:8000

# Nome da aplicação
VITE_APP_NAME=Kurae

# URL pública do site (usada em canonical, Open Graph e JSON-LD). Sem barra final.
# Produção: https://kurae.dev.br
VITE_SITE_URL=http://localhost:5173

# Feature flags (usadas em produção)
VITE_FEATURE_NEW_DASHBOARD=true
VITE_FEATURE_FILE_UPLOAD=false
